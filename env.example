# Токен бота от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Ваш Telegram user id (узнать у @userinfobot) — вы всегда админ, доступ выдаётся сразу
ADMIN_ID=123456789

# Публичный HTTPS-адрес, на котором будет жить это приложение (его даст хостинг после деплоя)
WEBAPP_URL=https://your-app.onrender.com

# Название файла с ключом сервисного аккаунта Google (см. шаг 3 инструкции)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Точные названия ваших Google-таблиц
SHEET_REVENUE_NAME=Ip 2026
SHEET_EXPENSES_NAME=Расходы
